  "policy": {
    "license_policy": "Allow legally compatible open-source code, including MIT, Apache-2.0, MPL-2.0 and dual-licensed crates; review GPL/LGPL/linking and redistribution obligations individually before adoption.",
    "technical_policy": "Evaluate every shortlisted upstream. Prefer objectively better correctness/performance after fixtures and benchmarks; one implementation per mathematical operation, with adapters rather than parallel kernels.",
    "attribution": "Keep upstream licenses/notices and source references; audit complete dependency graph and upstream license changes.",
    "gates": [
      "acceptance_fixtures",
      "memory_cancellation",
      "cross_platform_rust_1_95",
      "API_and_OrbWeaver_shared_interface_when_relevant",
      "workspace_CI",
      "separate_import_export_fidelity"
    ]
  },
  "review_process": {
    "order": [
      "Existing implementation and source comparison",
      "Minimal adapter or isolated experimental integration",
      "Accept/reject via accuracy fixtures and performance benchmarks",
      "Native CI on Linux/Windows/macOS",
      "Promote to canonical shared service only after passing"
    ],
    "decision_threshold": "No redundant engine, failing license obligation, loss of precision/identity or unbounded memory; keep candidate on experiment branch otherwise"
  }
}
