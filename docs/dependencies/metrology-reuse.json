{
  "schema_version": 1,
  "purpose": "Scan metrology, mesh repair, reconstruction and fabrication dependency planning. Behavioral inspirations include GOM, PolyWorks and Geomagic Design X, never proprietary source.",
  "policy": {
    "one_engine": "Every shared numeric/geometry operation is implemented exactly once in the Rust kernel; applications, CAD commands, OrbWeaver nodes, APIs and proprietary host connectors are thin adapters.",
    "truthful_status": "Existing kernel reuse references source-registered operations, but every planned primitive and tool adapter here remains planned until implemented, tested and integrated.",
    "bounded_memory": "Immutable revision-keyed point/triangle spatial indexes, bounded work queues, cached derived data and cancelable scan jobs; never force scan point data into per-entity CAD objects.",
    "optional_dependencies": "No CAD, OrbWeaver, Scan or fabrication executable requires the others; external GOM/PolyWorks/Design X APIs are optional, with no mandatory licensed host.",
    "tolerance": "Explicit units, coordinate frames, numerical tolerances, degeneracy policy and per-output provenance on each fit, grouping and deviation.",
    "scheduling": "Build low-level spatial queries, fitting and rigid registration before ICP, deviation inspection or reverse-engineering workspaces. Metrology does not delay the CAD alpha."
  },
