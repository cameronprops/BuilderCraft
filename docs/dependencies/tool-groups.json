{
  "schema_version": 1,
  "scope": "Worldwright foundational dependency DAG; all catalogue assignments provisional until reviewed",
  "classification_policy": "Tags and name-based classes guide ordering only. They do not claim verified command/component semantics, implementation or Grasshopper parity.",
  "groups": [
    {
      "id": "foundation.values",
      "tier": 0,
      "requires": [],
      "scope": "Typed scalar/text/boolean values, option schemas, validated inputs"
    },
    {
      "id": "foundation.units_frames",
      "tier": 0,
      "requires": [
        "foundation.values"
      ],
      "scope": "Units, handedness, coordinate frames, tolerances"
    },
    {
      "id": "foundation.identities",
      "tier": 0,
      "requires": [
        "foundation.values"
      ],
      "scope": "Stable IDs, revisions, object ownership"
    },
    {
      "id": "math.scalar",
      "tier": 1,
      "requires": [
        "foundation.values"
      ],
      "scope": "Numbers, domains, formulas and arithmetic"
    },
    {
      "id": "math.vector",
      "tier": 1,
      "requires": [
        "math.scalar",
        "foundation.units_frames"
      ],
      "scope": "Vectors, dot/cross, normalization and angles"
    },
    {
      "id": "geometry.point",
      "tier": 2,
      "requires": [
        "math.vector",
        "foundation.units_frames"
      ],
      "scope": "3D points, distances and interpolation"
    },
    {
      "id": "geometry.polyline",
      "tier": 3,
      "requires": [
        "geometry.point"
      ],
      "scope": "Segments, connected polylines, arc-length sampling"
    },
    {
      "id": "geometry.transforms",
      "tier": 3,
      "requires": [
        "math.vector",
        "geometry.point",
        "foundation.units_frames"
      ],
      "scope": "Exact affine transforms, matrices, frame policies"
    },
    {
      "id": "geometry.curve",
      "tier": 4,
      "requires": [
        "geometry.polyline",
        "geometry.transforms"
      ],
      "scope": "Parametric curves, evaluations, knots and continuity"
    },
    {
      "id": "geometry.mesh",
      "tier": 4,
      "requires": [
        "geometry.point",
        "math.vector"
      ],
      "scope": "Triangles/quads, vertex attributes and bounded mesh access"
    },
    {
      "id": "geometry.surface",
      "tier": 5,
      "requires": [
        "geometry.curve",
        "geometry.transforms"
      ],
      "scope": "NURBS and other surface construction, normals"
    },
    {
      "id": "geometry.mesh_topology",
      "tier": 5,
      "requires": [
        "geometry.mesh"
      ],
      "scope": "Halfedges, manifold diagnostics, component selections, mesh repairs"
    },
    {
      "id": "geometry.intersections",
      "tier": 6,
      "requires": [
        "geometry.curve",
        "geometry.surface",
        "geometry.mesh_topology"
      ],
      "scope": "Intersection solvers, projection, tolerances, split events"
    },
    {
      "id": "geometry.solid",
      "tier": 7,
      "requires": [
        "geometry.intersections",
        "geometry.mesh_topology"
      ],
      "scope": "BRep solids, booleans, offset, shell, fillet"
    },
    {
      "id": "workflow.document",
      "tier": 2,
      "requires": [
        "foundation.identities",
        "foundation.units_frames"
      ],
      "scope": "Document persistence, editing revisions, copy/undo"
    },
    {
      "id": "workflow.selection",
      "tier": 4,
      "requires": [
        "workflow.document",
        "geometry.point"
      ],
      "scope": "Picking, snaps, overlays and selections"
    },
    {
      "id": "workflow.display",
      "tier": 5,
      "requires": [
        "workflow.selection",
        "geometry.mesh"
      ],
      "scope": "Viewport, tessellation, preview and materials"
    },
    {
      "id": "workflow.exchange",
      "tier": 6,
      "requires": [
        "workflow.document",
        "geometry.mesh"
      ],
      "scope": "File adapters and host interchange"
    },
    {
      "id": "workflow.model_edit",
      "tier": 6,
      "requires": [
        "workflow.document",
        "workflow.selection",
        "geometry.mesh_topology"
      ],
      "scope": "Transaction-bound native object edits, revisioned picks and undo/bake wrappers"
    },
    {
      "id": "graph.typed_ports",
      "tier": 1,
      "requires": [
        "foundation.values"
      ],
      "scope": "Typed graph values, port contracts, no implicit coercion"
    },
    {
      "id": "graph.execution",
      "tier": 2,
      "requires": [
        "graph.typed_ports"
      ],
      "scope": "Deterministic DAG execution, cycles, bounds and error propagation"
    },
    {
      "id": "graph.list_tree",
      "tier": 3,
      "requires": [
        "graph.execution"
      ],
      "scope": "Strictly keyed paths, native ordered tree values, explicit item matching and tree-aware numerical broadcasting"
    },
    {
      "id": "graph.preview_bake",
      "tier": 6,
      "requires": [
        "graph.list_tree",
        "workflow.document",
        "workflow.display"
      ],
      "scope": "Preview, bake, ownership and scene update"
    },
    {
      "id": "graph.constraints",
      "tier": 6,
      "requires": [
        "graph.list_tree",
        "geometry.point",
        "math.vector"
      ],
      "scope": "Goal solvers/physics, bounded iterative relaxation"
    },
    {
      "id": "discipline.scan",
      "tier": 7,
      "requires": [
        "geometry.mesh_topology",
        "geometry.transforms",
        "workflow.exchange"
      ],
      "scope": "Registration, metrology, QA and reconstruction"
    },
    {
      "id": "discipline.scenic",
      "tier": 8,
      "requires": [
        "geometry.solid",
        "graph.preview_bake",
        "discipline.scan"
      ],
      "scope": "Scenic rock/terrain, fabrication, connectors"
    },
    {
      "id": "discipline.previs",
      "tier": 8,
      "requires": [
        "workflow.display",
        "graph.preview_bake",
        "workflow.exchange"
      ],
      "scope": "Ride paths, lighting, show control, animation"
    },
    {
      "id": "workflow.feature_history",
      "tier": 5,
      "requires": [
        "workflow.document",
        "graph.execution",
        "graph.list_tree"
      ],
      "scope": "Optional document/block/component timeline, revisions, parameters, dependencies, suppression, rollback and atomic edits"
    },
    {
      "id": "workflow.feature_timeline_ui",
      "tier": 6,
      "requires": [
        "workflow.feature_history",
        "workflow.display",
        "workflow.selection"
      ],
      "scope": "History browser, edit/drag reorder and rollback controls in selected modeling workspaces"
    },
    {
      "id": "mechanical.sketch",
      "tier": 7,
      "requires": [
        "workflow.feature_history",
        "geometry.curve",
        "graph.constraints"
      ],
      "scope": "Dimensional sketch planes, constrained profiles, diagnostics and stable geometry references"
    },
    {
      "id": "mechanical.features",
      "tier": 8,
      "requires": [
        "mechanical.sketch",
        "geometry.solid",
        "workflow.feature_history"
      ],
      "scope": "Shared sketch-based extrude/revolve/sweep/loft/hole, fillets, chamfers, shells, patterns and mirrors"
    },
    {
      "id": "mechanical.assembly",
      "tier": 9,
      "requires": [
        "mechanical.features",
        "workflow.feature_history",
        "graph.constraints"
      ],
      "scope": "Part definitions and instances, mates, joints, motion and component-local parameters"
    },
    {
      "id": "unclassified",
      "tier": null,
      "requires": [],
      "scope": "Reference awaiting individual behavioral/dependency review"
    }
  ],
