    {
      "id": "discipline.scenic",
      "tier": 8,
      "requires": [
        "geometry.solid",
        "graph.preview_bake",
        "discipline.scan"
      ],
      "scope": "Scenic rock/terrain, fabrication, connectors"
    },
    {
